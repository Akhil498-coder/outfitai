# Copy to .env and fill in real values. NEVER commit .env.
# Variable names only here - no real values.

# Which Spring profile to run: h2 (default, in-memory) or postgres
SPRING_PROFILES_ACTIVE=

# Needed only for the postgres profile
DB_URL=
DB_USER=
DB_PASSWORD=

# Required always (the app refuses to start without them)
JWT_SECRET=            # random string, at least 32 characters, signs our login tokens
GOOGLE_CLIENT_ID=      # OAuth "Web application" client id from Google Cloud Console
